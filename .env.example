# Database Connection URL (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# To use Supabase, copy the connection string from your Supabase Dashboard under Settings > Database.
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/hotel_staff_manager

# SMTP Configuration (for sending real emails)
# If left blank, it will automatically fall back to Ethereal mock SMTP with preview URLs in the console.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password
# SMTP_FROM="Red Fox Hotel" <your-email@gmail.com>
